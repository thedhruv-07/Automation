WHATSAPP_TOKEN=your_permanent_system_user_token_here
PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_TEMPLATE_NAME=cert_renewal_alert
WHATSAPP_TEMPLATE_LANG=en
EMAIL_SENDER=your_verified_sender@example.com
BREVO_API_KEY=your_brevo_api_key_here
# Optional -- a separate Brevo account's API key for follow-up emails (own
# 300/day quota). Follow-ups still send from EMAIL_SENDER, so that address must
# be a verified sender on that account too. Unset = use BREVO_API_KEY.
#
# When set, it's also used for OVERFLOW: once a "Send All Emails" run exhausts
# BREVO_API_KEY's own daily quota, it spills the rest into this same account
# (sharing its 300/day with follow-ups, not a quota of its own). Sent from
# OVERFLOW_EMAIL_SENDER if set, else EMAIL_SENDER -- either way that address
# must be a verified sender on this account too.
# FOLLOWUP_BREVO_API_KEY=
# OVERFLOW_EMAIL_SENDER=
# Optional -- redirects all real WhatsApp/email sends to a single verified
# test recipient instead of real clients. Leave unset for real sends.
DASHBOARD_TEST_NUMBER=
DASHBOARD_TEST_EMAIL=
# Optional -- only needed for a public deployment (e.g. Render). Unset
# locally, auth is disabled and the dashboard behaves exactly as before.
DASHBOARD_USERNAME=choose_an_admin_username
DASHBOARD_PASSWORD=choose_a_strong_password
# Optional -- the deployed frontend's origin, added to the CORS allow-list.
DASHBOARD_ALLOWED_ORIGIN=https://your-frontend.vercel.app
# Optional -- overrides where clients.db lives (e.g. a Render persistent
# disk mount path like /data/clients.db). Defaults to the repo checkout.
DASHBOARD_DB_PATH=/data/clients.db
